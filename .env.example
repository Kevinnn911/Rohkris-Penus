# =====================================================================
# Rohkris Pelita Nusantara — contoh environment variables
#
# Salin berkas ini menjadi `.env.local`, lalu isi nilainya.
# JANGAN pernah commit `.env.local` ke repository.
# =====================================================================

# ---------------------------------------------------------------------
# DATABASE MySQL — RAHASIA, hanya dibaca server.
#
# Di cPanel: menu "MySQL® Databases" → buat database + user, lalu
# "Add User To Database" dengan hak SELECT, INSERT, UPDATE, DELETE.
# Nama database & user di cPanel biasanya berawalan nama akun,
# misalnya "akunanda_rohkris".
# ---------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# Alternatif satu baris (bila diisi, menggantikan lima variabel di atas):
# DATABASE_URL=mysql://user:password@localhost:3306/nama_database

# ---------------------------------------------------------------------
# Folder penyimpanan foto/poster yang diunggah admin.
# Kosongkan untuk memakai "<folder aplikasi>/storage/uploads".
# Di cPanel SANGAT disarankan memakai folder di luar folder aplikasi agar
# foto tidak ikut terhapus saat deploy ulang, misalnya:
#   UPLOAD_DIR=/home/akunanda/rohkris-uploads
# ---------------------------------------------------------------------
UPLOAD_DIR=

# ---------------------------------------------------------------------
# PUBLIK — ikut terkirim ke browser.
# Alamat situs untuk metadata SEO, Open Graph, dan sitemap.
# Contoh: https://rohkris.sekolahanda.sch.id
# Boleh dikosongkan saat pengembangan (otomatis http://localhost:3000).
# ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------
# GERBANG PANEL ADMIN — RAHASIA, hanya dibaca server.
# Kunci UUID rahasia untuk melindungi panel admin dari akses publik.
# Siapapun yang mengakses /admin atau /admin/login tanpa kunci ini akan
# mendapatkan halaman 404 (Not Found).
# Contoh URL akses: https://domainanda.com/admin/login?key=<UUID>
# ---------------------------------------------------------------------
ADMIN_SECRET_KEY=ISI-DENGAN-UUID-ACAK

# ---------------------------------------------------------------------
# FORMULIR INTERNAL — berkas unggahan peserta (PRIVAT).
# Kosongkan untuk memakai "<folder aplikasi>/storage/form-uploads".
# Di cPanel arahkan ke folder di luar folder aplikasi dan di luar
# public_html, dan JANGAN di dalam UPLOAD_DIR (folder itu disajikan publik).
# Contoh: FORM_UPLOAD_DIR=/home/akunanda/rohkris-form-uploads
# ---------------------------------------------------------------------
FORM_UPLOAD_DIR=

# ---------------------------------------------------------------------
# EMAIL KONFIRMASI FORMULIR (opsional). Kosongkan bila tidak dipakai.
# MAIL_TRANSPORT=smtp     → isi SMTP_* (akun email cPanel)
# MAIL_TRANSPORT=sendmail → memakai /usr/sbin/sendmail milik hosting
# ---------------------------------------------------------------------
MAIL_FROM=
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
